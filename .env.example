# Application Settings
APP_NAME=SID//OS API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Database Settings
DATABASE_URL=postgresql+asyncpg://sid_os:sid_os_password@localhost:5432/sid_os

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Authentication & Session Settings
SESSION_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
SESSION_COOKIE_NAME=sid_session
SESSION_EXPIRE_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Logging
LOG_LEVEL=INFO

# PostgreSQL Container Configuration (used by Docker Compose)
POSTGRES_DB=sid_os
POSTGRES_USER=sid_os
POSTGRES_PASSWORD=sid_os_password
POSTGRES_PORT=5432
